DESCRIPTION >
    Prompt tokens per robot per simulated minute, for the context chart: three
    lines climbing and full history crossing 32,768. The last row in a minute
    wins. run defaults to the newest run.

NODE context_by_minute_node
SQL >
    %
    SELECT robot, t, argMax(context_tokens, seq) AS context_tokens
    FROM events
    WHERE run = {% if defined(run) %}{{ String(run) }}{% else %}(SELECT max(run) FROM events){% end %}
    GROUP BY robot, t
    ORDER BY robot, t

TYPE endpoint
